{
  "id": "character_sheet",
  "title": "Character Sheet: {hero_name} ({hero_class})",
  "frames": [
    {
      "id": "status",
      "role": "status",
      "ratio": 0.15,
      "priority": "P0",
      "overflow": "collapse"
    },
    {
      "id": "scene",
      "role": "scene",
      "ratio": 0.5,
      "priority": "P0",
      "overflow": "truncate"
    },
    {
      "id": "context",
      "role": "context",
      "ratio": 0.2,
      "priority": "P1",
      "overflow": "page"
    },
    {
      "id": "actions",
      "role": "actions",
      "ratio": 0.15,
      "priority": "P0",
      "overflow": "collapse"
    }
  ],
  "controls": [
    {
      "type": "text",
      "frame": "scene",
      "value": "Character Sheet: {hero_name} ({hero_class})",
      "id": "screen_title",
      "variant": "title"
    },
    {
      "type": "text",
      "id": "hero_identity",
      "frame": "status",
      "value": "{hero_name} \u00b7 {hero_class} \u00b7 Gold: ${cash}"
    },
    {
      "type": "progressbar",
      "id": "hp_bar",
      "frame": "status",
      "label": "HP",
      "value": "{hp}",
      "max": "{max_hp}",
      "kind": "health",
      "thresholds": {
        "warning": 0.35,
        "critical": 0.15
      },
      "show_text": true,
      "compact": true
    },
    {
      "type": "progressbar",
      "id": "carry_bar",
      "frame": "status",
      "label": "Carry",
      "value": "{total_weight}",
      "max": "{max_weight}",
      "kind": "capacity",
      "thresholds": {
        "warning": 0.8,
        "critical": 1.0
      },
      "show_text": true,
      "compact": true
    },
    {
      "type": "progressbar",
      "id": "journey_bar",
      "frame": "status",
      "label": "Leg {leg}/5 \u00b7 Event",
      "value": "{event}",
      "max": 20,
      "kind": "journey",
      "show_text": true,
      "compact": true
    },
    {
      "type": "text",
      "frame": "scene",
      "value": "Title: {character_title}"
    },
    {
      "type": "progressbar",
      "id": "honor_progress",
      "frame": "context",
      "label": "Honor",
      "value": "{honor_mark}",
      "max": 15,
      "kind": "honor",
      "show_text": true
    },
    {
      "type": "list",
      "id": "list_character_stats",
      "frame": "context",
      "label": "Stats (Base vs Effective)",
      "overflow": "page",
      "max_rows": 8
    },
    {
      "type": "list",
      "id": "list_character_equipment",
      "frame": "context",
      "label": "Equipment Bonuses by Slot",
      "overflow": "page",
      "max_rows": 7
    },
    {
      "type": "button",
      "frame": "actions",
      "label": "Close",
      "action": "close_character_sheet"
    }
  ]
}
