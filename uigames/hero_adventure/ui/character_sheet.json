{
  "id": "character_sheet",
  "title": "Character Sheet: {hero_name} ({hero_class})",
  "text": [
    "HP: {hp}/{max_hp}   Gold: ${cash}",
    "Title: {character_title}",
    "Honor Mark: {honor_mark}/15",
