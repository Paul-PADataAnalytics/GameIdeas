#!/bin/bash

# Hero Adventure Game Launcher - Choose GUI or Terminal

echo ""
echo "═══════════════════════════════════════════════"
echo "       ⚔️  HERO ADVENTURE - GAME LAUNCHER  ⚔️"
echo "═══════════════════════════════════════════════"
echo ""
echo "Choose your interface:"
echo "1. GUI (Clickable Interface)"
echo "2. Terminal (Text-based)"
echo "3. Quit"
echo ""

read -p "Select [1-3]: " choice

case $choice in
    1)
        echo "Launching GUI version..."
        python3 play_gui.py
        ;;
    2)
        echo "Launching Terminal version..."
        python3 play.py
        ;;
    3)
        echo "Goodbye, adventurer!"
        exit 0
        ;;
    *)
        echo "Invalid choice. Exiting..."
        exit 1
        ;;
esac
