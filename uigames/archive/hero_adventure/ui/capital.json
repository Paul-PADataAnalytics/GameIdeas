{
  "id": "capital",
  "title": "The Capital",
  "frames": [
    {
      "id": "status",
      "role": "status",
      "ratio": 0.15,
      "priority": "P0",
      "overflow": "collapse"
    },
    {
      "id": "scene",
      "role": "scene",
      "ratio": 0.5,
      "priority": "P0",
      "overflow": "truncate"
    },
    {
      "id": "context",
      "role": "context",
      "ratio": 0.2,
      "priority": "P1",
      "overflow": "page"
    },
    {
      "id": "actions",
      "role": "actions",
      "ratio": 0.15,
      "priority": "P0",
      "overflow": "collapse"
    }
  ],
  "controls": [
    {
      "type": "text",
      "frame": "scene",
      "value": "The Capital",
      "id": "screen_title",
      "variant": "title"
    },
    {
      "type": "text",
      "id": "hero_identity",
      "frame": "status",
      "value": "{hero_name} \u00b7 {hero_class} \u00b7 Age {age} \u00b7 Gold: ${cash}"
    },
    {
      "type": "progressbar",
      "id": "hp_bar",
      "frame": "status",
      "label": "HP",
      "value": "{hp}",
      "max": "{max_hp}",
      "kind": "health",
      "thresholds": {
        "warning": 0.35,
        "critical": 0.15
      },
      "show_text": true,
      "compact": true
    },
    {
      "type": "progressbar",
      "id": "carry_bar",
      "frame": "status",
      "label": "Carry",
      "value": "{total_weight}",
      "max": "{max_weight}",
      "kind": "capacity",
      "thresholds": {
        "warning": 0.8,
        "critical": 1.0
      },
      "show_text": true,
      "compact": true
    },
    {
      "type": "progressbar",
      "id": "journey_bar",
      "frame": "status",
      "label": "Leg {leg}/5 \u00b7 Event",
      "value": "{event}",
      "max": 20,
      "kind": "journey",
      "show_text": true,
      "compact": true
    },
    {
      "type": "text",
      "frame": "scene",
      "value": "{hero_name} the failed adventurer, forced into retirement at age {age}.",
      "visible_if": "failed_adventurer"
    },
    {
      "type": "text",
      "frame": "scene",
      "value": "{failed_adventurer_text}",
      "visible_if": "failed_adventurer"
    },
    {
      "type": "text",
      "frame": "scene",
      "value": "Choose a house to buy, or keep the pension and retire at a tavern."
    },
    {
      "type": "text",
      "frame": "scene",
      "value": "Score = house multiplier \u00d7 pension; tavern retirement uses pension only."
    },
    {
      "type": "list",
      "id": "list_houses",
      "frame": "context",
      "label": "Houses",
      "overflow": "page",
      "max_rows": 6
    },
    {
      "type": "button",
      "frame": "actions",
      "label": "Keep Pension / Tavern",
      "action": "keep_pension"
    }
  ]
}
